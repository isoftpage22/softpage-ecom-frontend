# Loaded by `next build` / Vercel Production + Preview.
# NEXT_PUBLIC_* is inlined into the client bundle at build time.
# Import this file in Vercel → Environment Variables if the repo copy is missing.

NEXT_PUBLIC_API_URL=https://api.softpage.in

# Used only when Host cannot be resolved (bare *.vercel.app). Live restaurant
# hosts such as asian-box-restaurant.softpage.in go through by-host.
NEXT_PUBLIC_BUSINESS_ID=67
NEXT_PUBLIC_BUSINESS_APP_ID=67
NEXT_PUBLIC_STORE_SUBDOMAIN=asian-box

NEXT_PUBLIC_USE_GOOGLE_MAPS=true
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBtPegx-IViUCQqjGxdwrEK3_5yCMdUmrE
