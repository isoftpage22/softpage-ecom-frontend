# Copy to .env.local for `next dev`.
# For Vercel: import `.env.production` (Project → Environment Variables → Import .env).

# Backend origin (no trailing /api). GraphQL is ${this}/api/v1/graphql.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Used when Host cannot be resolved (localhost / preview).
NEXT_PUBLIC_BUSINESS_ID=1
NEXT_PUBLIC_BUSINESS_APP_ID=1

# Localhost branding fallback. Production uses Host such as
# asian-box-restaurant.softpage.in → GET /api/v1/public/store/by-host.
NEXT_PUBLIC_STORE_SUBDOMAIN=asian-box

# Optional. Maps JavaScript. OSM is the fallback if the flag is off, the key
# is missing, or Google rejects the page (RefererNotAllowedMapError).
# Restrict the key in Google Cloud → APIs & Services → Credentials → the key
# → Application restrictions → Websites. Include every origin you use, with port:
#   http://localhost:3001/*
#   http://localhost:3002/*
#   http://127.0.0.1:3001/*
#   https://*.softpage.in/*
#   https://asian-box-restaurant.softpage.in/*
NEXT_PUBLIC_USE_GOOGLE_MAPS=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Vercel Production (same keys as .env.production) ---
# NEXT_PUBLIC_API_URL=https://api.softpage.in
# NEXT_PUBLIC_BUSINESS_ID=67
# NEXT_PUBLIC_BUSINESS_APP_ID=67
# NEXT_PUBLIC_STORE_SUBDOMAIN=asian-box
# NEXT_PUBLIC_USE_GOOGLE_MAPS=true
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
